# ---------------------------------------------------------------------------
# Client environment variables
# Copy to `.env.local` for local development and add the same key in the
# Vercel project settings for the client deployment.
# ---------------------------------------------------------------------------

# Base URL of the Express API (no trailing slash).
# Local:  http://localhost:5000
# Vercel: https://your-server-project.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000
