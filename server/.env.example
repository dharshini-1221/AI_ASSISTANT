# ---------------------------------------------------------------------------
# Server environment variables
# Copy to `.env` for local development and mirror the same keys in the
# Vercel project settings before deploying.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Set to "true" when the app runs behind a proxy/load balancer (Vercel, Render,
# Railway, nginx). Required for correct client IPs and secure cookies.
TRUST_PROXY=false

# --- Database --------------------------------------------------------------
# MongoDB Atlas connection string. The cluster must allow the deployment to
# connect (0.0.0.0/0 for Vercel, or the Vercel egress ranges).
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ai_interview?retryWrites=true&w=majority

# --- Authentication --------------------------------------------------------
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-64-character-random-string

# 32-byte key as 64 hex characters, e.g. `openssl rand -hex 32`.
# Encrypts login history, active sessions, and other sensitive fields.
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# --- AI --------------------------------------------------------------------
GEMINI_API_KEY=AQ.replace_me
GEMINI_MODEL=gemini-3.5-flash

# --- Client origin(s) ------------------------------------------------------
# Comma-separated. Include the local origin and every deployed client origin
# (add Vercel preview domains here if you use them).
CLIENT_URL=http://localhost:3000

# --- Email (SMTP) ----------------------------------------------------------
# Verification and password-reset mail. Gmail requires an app password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your@gmail.com

# --- Resume OCR (optional) -------------------------------------------------
# Empty = cache to "." locally and to "/tmp" on Vercel.
TESSERACT_CACHE_PATH=

# Set to "true" to keep OCR enabled on Vercel. Disabled by default there
# because the native canvas/Tesseract path is slow on cold starts.
ENABLE_OCR=

# --- Placement readiness weights (optional) --------------------------------
READINESS_RESUME_WEIGHT=25
READINESS_INTERVIEW_WEIGHT=35
READINESS_COMMUNICATION_WEIGHT=20
READINESS_SKILL_WEIGHT=20
READINESS_PLACEMENT_READY=80
READINESS_HIGH_POTENTIAL=60
